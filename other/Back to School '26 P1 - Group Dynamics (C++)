#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N;
    cin >> N;

    vector<int> a(N), b(N);

    int sumA = 0, sumB = 0;
    int oddA = 0, oddB = 0;

    for (int i = 0; i < N; i++) {
        cin >> a[i];
        sumA += a[i];

        if (a[i] % 2 == 1)
            oddA++;
    }

    for (int i = 0; i < N; i++) {
        cin >> b[i];
        sumB += b[i];

        if (b[i] % 2 == 1)
            oddB++;
    }


    if (oddA == 0) {
        if (a == b)
            cout << "YES\n";
        else
            cout << "NO\n";
    }
    else {
        if (sumA == sumB && oddA == oddB)
            cout << "YES\n";
        else
            cout << "NO\n";
    }

    return 0;
}
