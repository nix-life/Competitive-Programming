#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<vector<int>> graph(n + 1);
    vector<bool> ending(n + 1, false);

    for (int i = 1; i <= n; i++) {
        int choices;
        cin >> choices;

        if (choices == 0) {
            ending[i] = true;
        }

        for (int j = 0; j < choices; j++) {
            int next;
            cin >> next;
            graph[i].push_back(next);
        }
    }

    queue<int> q;
    vector<bool> visited(n + 1, false);
    vector<int> distance(n + 1, -1);

    q.push(1);
    visited[1] = true;
    distance[1] = 0;

    int shortest = INT_MAX;

    while (!q.empty()) {
        int current = q.front();
        q.pop();
        
        if (ending[current]) {
            shortest = min(shortest, distance[current] + 1);
        }

        for (int next : graph[current]) {
            if (!visited[next]) {
                visited[next] = true;
                distance[next] = distance[current] + 1;
                q.push(next);
            }
        }
    }

    bool allReachable = true;

    for (int i = 1; i <= n; i++) {
        if (!visited[i]) {
            allReachable = false;
            break;
        }
    }

    if (allReachable) {
        cout << "Y\n";
    } else {
        cout << "N\n";
    }

    cout << shortest << "\n";

    return 0;
}
