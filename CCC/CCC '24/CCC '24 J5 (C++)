#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int r, c;
    cin >> r >> c;

    vector<string> patch(r);
    vector<vector<bool>> vis(r, vector<bool>(c, false));

    for (int i = 0; i < r; i++) {
        cin >> patch[i];
    }

    int start_a, start_b;
    cin >> start_a >> start_b;

    auto valid = [&](int x, int y) {
        if (x >= 0 && x < r && y >= 0 && y < c) {
            if (!vis[x][y]) {
                if (patch[x][y] != '*') {
                    return true;
                }
            }
        }
        return false;
    };

    queue<pair<int, int>> q;
    int score = 0;

    vis[start_a][start_b] = true;
    q.push({start_a, start_b});

    char cur = patch[start_a][start_b];
    if (cur == 'S') score += 1;
    else if (cur == 'M') score += 5;
    else if (cur == 'L') score += 10;

    int dx[] = {1, -1, 0, 0};
    int dy[] = {0, 0, 1, -1};

    while (!q.empty()) {
        auto [x, y] = q.front();
        q.pop();

        for (int i = 0; i < 4; i++) {
            int nx = x + dx[i];
            int ny = y + dy[i];

            if (valid(nx, ny)) {
                vis[nx][ny] = true;
                char neighbor_cur = patch[nx][ny];
                if (neighbor_cur == 'S') score += 1;
                else if (neighbor_cur == 'M') score += 5;
                else if (neighbor_cur == 'L') score += 10;

                q.push({nx, ny});
            }
        }
    }

    cout << score << "\n";

    return 0;
}
