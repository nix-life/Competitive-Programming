import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
		int total = 0;
		for (int i = 0; i < 6; i++) {
			String s = sc.nextLine();
			if (s.equals("W")) {
				total++;
			}
		}
		if (total > 4)  {
			System.out.println(1);
		} else if (total > 2) {
			System.out.println(2);
		} else if (total > 0) {
			System.out.println(3);
		} else {
			System.out.println(-1);
		}
    }
}
