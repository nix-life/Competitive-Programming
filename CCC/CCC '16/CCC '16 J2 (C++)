#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    vector<int> a(4);
    vector<int> b(4);
    vector<int> c(4);
    vector<int> d(4);
    for (int i = 0; i < 4; i++) cin >> a[i];
    for (int i = 0; i < 4; i++) cin >> b[i];
    for (int i = 0; i < 4; i++) cin >> c[i];
    for (int i = 0; i < 4; i++) cin >> d[i];

    int a_value = a[0]+a[1]+a[2]+a[3];
    int b_value = b[0]+b[1]+b[2]+b[3];
    int c_value = c[0]+c[1]+c[2]+c[3];
    int d_value = d[0]+d[1]+d[2]+d[3];

    if (a_value == b_value && b_value == c_value && c_value == d_value) {
        int c1 = a[0]+b[0]+c[0]+d[0];
        int c2 = a[1]+b[1]+c[1]+d[1];
        int c3 = a[2]+b[2]+c[2]+d[2];
        int c4 = a[3]+b[3]+c[3]+d[3];
        if (c1 == c2 && c2 == c3 && c3 == c4 && c4 == a_value) {
            cout << "magic\n";
        } else cout << "not magic\n";
    } else {
        cout << "not magic\n";
    }

    return 0;
}
