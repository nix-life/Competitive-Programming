#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin >> n;

    int left = 0;
    int p = 0;
    int ans = 0;

    vector<char> a(n);

    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    for (int right = 0; right < n; right++) {
        if (a[right] == 'P') {
            p++;
        }

        while (p > 1) {
            if (a[left] == 'P') {
                p--;
            }
            left++;
        }

        ans = max(ans, right - left + 1);
    }
    
    bool hasP = false;

    for (char c : a) {
        if (c == 'P') {
            hasP = true;
            break;
        }
    }

    if (!hasP) {
        ans--;
    }

    cout << ans << '\n';
}
