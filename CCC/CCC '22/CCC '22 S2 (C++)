#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    cin >> n;
    
    vector<pair<string, string>> x(n);
    for (int i = 0; i < n; ++i) {
        cin >> x[i].first >> x[i].second;
    }

    int m;
    cin >> m;
    vector<pair<string, string>> y(m);
    for (int i = 0; i < m; ++i) {
        cin >> y[i].first >> y[i].second;
    }

    int g_count;
    cin >> g_count;
    unordered_map<string, int> groups;
    for (int cnt = 0; cnt < g_count; ++cnt) {
        string a, b, c;
        cin >> a >> b >> c;
        groups[a] = cnt;
        groups[b] = cnt;
        groups[c] = cnt;
    }

    int ans = 0;
    for (const auto& item : x) {
        if (groups[item.first] != groups[item.second]) {
            ans++;
        }
    }

    for (const auto& item : y) {
        if (groups[item.first] == groups[item.second]) {
            ans++;
        }
    }

    cout << ans << "\n";

    return 0;
}
